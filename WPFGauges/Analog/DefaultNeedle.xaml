<UserControl x:Class="WPFGauges.Analog.DefaultNeedle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WPFGauges.Analog"
             xmlns:converters="clr-namespace:WPFGauges.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:DefaultNeedle, IsDesignTimeCreatable=True}"
             Foreground="Black"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:FindCenterCoordinate x:Key="FindCenterCoordinate" />
        <converters:Scale x:Key="Scale" />
    </UserControl.Resources>
    <Grid x:Name="_mainGrid" Width="100" Height="100">
        <Ellipse Width="{Binding Height, ElementName=_mainGrid, Converter={StaticResource Scale}, ConverterParameter=0.10}" Height="{Binding Width, RelativeSource={RelativeSource Mode=Self}}" Fill="{Binding Foreground}" />
        <Ellipse Width="{Binding ElementName=_mainGrid, Converter={StaticResource FindCenterCoordinate}}" Height="{Binding Height, ElementName=_mainGrid, Converter={StaticResource Scale}, ConverterParameter=0.05}" HorizontalAlignment="Left" Fill="{Binding Foreground}" />
    </Grid>
</UserControl>
